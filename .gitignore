# Local environment and tooling artifacts (not part of this project)

# Shell startup files
.bash_profile
.bashrc
.profile
.zprofile
.zshrc

# Editor / IDE
.idea
.vscode

# Assistant / tooling config
.claude/*
# appsec-advisor plugin runtime state (session logs, budget, open tool calls)
docs/security/
