{
  "packs": [
    {
      "id": "acme-authentication",
      "file": "packs/authentication.md",
      "owner": "Application Security",
      "source": "policy/IAM-7",
      "trigger": "Login, SSO, sessions, tokens, or anything that decides who the user is",
      "paths": ["**/auth/**", "**/login/**"],
      "blueprints": ["blueprints/spa/1.0.0.json"],
      "requirements": {
        "ACME-SSO-001": {"narrows": ["aiscb-MECHANISMS-001", "aiscb-AUTH-001"]},
        "ACME-IAM-AUDIT-001": {"narrows": ["aiscb-ERRORS-001"]}
      }
    },
    {
      "id": "acme-deployment",
      "file": "packs/deployment.md",
      "owner": "Platform Engineering",
      "source": "policy/OPS-3",
      "trigger": "Exposure, TLS termination, reverse proxies, containers, or first-start setup",
      "paths": ["**/deploy/**", "**/Dockerfile", "**/compose*.y*ml"],
      "blueprints": [],
      "requirements": {
        "ACME-EXPOSE-001": {"narrows": ["aiscb-DEFAULTS-001"]},
        "ACME-BOOTSTRAP-001": {"narrows": ["aiscb-SECRETS-001"]}
      }
    }
  ]
}
